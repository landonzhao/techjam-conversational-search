# Optional only. The deterministic evaluator needs no environment variables.
# Copy this file to .env; .env is gitignored. Never commit real values.
GEMINI_API_KEY=replace-with-your-key
# GOOGLE_API_KEY=replace-with-your-key
# GEMINI_API_KEY_2=replace-with-an-additional-key

# Structured execution tracing (disabled by default).
AGENT_TRACE=0
AGENT_TRACE_DIR=traces
